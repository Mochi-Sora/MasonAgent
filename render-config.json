{
  "agents": {
    "defaults": {
      "model": "anthropic/claude-opus-4-8",
      "provider": "auto"
    }
  },
  "providers": {
    "anthropic": {
      "apiKey": "${ANTHROPIC_API_KEY}"
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 8765
  },
  "tools": {
    "restrictToWorkspace": true,
    "my": {
      "allowSet": false
    }
  }
}
